{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.typecheck.tsbuildinfo",
        "paths": {
            "@/*": ["./packages/website/src/*"]
        }
    },
    "include": [
        "packages/llms/src/**/*",
        "packages/page-controller/src/**/*",
        "packages/ui/src/**/*",
        "packages/core/src/**/*",
        "packages/handoff/src/**/*",
        "packages/page-agent/src/**/*",
        "packages/website/src/**/*"
    ]
}
